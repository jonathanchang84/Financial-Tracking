# Cloudflare Workers static-asset headers for the PWA shell.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

  # `connect-src` is https: rather than 'self' for two reasons, and pinning it to
  # specific hosts would break one of them:
  #   1. the app documents a separate API origin (VITE_API_URL), which is a
  #      build-time value this static file cannot know;
  #   2. exchange rates are fetched from the provider.
  # It stays https-only so nothing can be downgraded to cleartext. A build step
  # that injects the configured API origin would allow a tighter policy, and the
  # only third party would then be the rate provider.

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Never let an intermediary serve a stale shell: a cached index.html keeps
# pointing at the previous build's hashed assets.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
