{
  "name": "Financial Dashboard",
  "short_name": "FinDash",
  "description": "Offline-first personal finance dashboard with optional account sync.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f7f9",
  "theme_color": "#0f766e",
  "categories": ["finance", "productivity"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Cash flow", "url": "/#cashflow" },
    { "name": "Overview", "url": "/#dashboard" }
  ]
}

