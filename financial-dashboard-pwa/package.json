{
  "name": "financial-dashboard-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first Svelte/Vite financial dashboard with application-owned Cloudflare authentication and sync.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:functional": "node scripts/functional-test.mjs",
    "test:browser": "node --test --test-force-exit --test-timeout=180000 tests/browser.spec.mjs",
    "setup": "playwright install chromium",
    "validate": "npm run test && npm run build && npm run test:functional && npm run test:browser",
    "deploy": "npm run validate && wrangler deploy",
    "checkpoint": "node scripts/checkpoint.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "playwright": "^1.63.0",
    "svelte": "^5.57.1",
    "vite": "^5.4.8",
    "wrangler": "^4.137.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
